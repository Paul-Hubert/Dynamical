{
  "dependencies": [
    "cereal",
    "doctest",
    "entt",
    "glm",
    "grpc",
    "joltphysics",
    "nlohmann-json",
    "protobuf",
    "stb",
    "taskflow"
  ],
  "default-features": [
    "viewer"
  ],
  "features": {
    "viewer": {
      "description": "dynamical: Vulkan, SDL2, OpenXR and glTF",
      "dependencies": [
        {
          "name": "openxr-loader",
          "features": [
            "vulkan"
          ]
        },
        {
          "name": "sdl2",
          "features": [
            "vulkan"
          ]
        },
        "tinygltf",
        "vulkan"
      ]
    }
  },
  "overrides": [
    {
      "name": "tinygltf",
      "version": "3.0.0",
      "port-version": 1
    }
  ]
}
