 /// A contact constraint manager manages all contacts between two bodies
 ///
 /// WARNING: This class is an internal part of PhysicsSystem, it has no functions that can be called by users of the library.
+/// One contact manifold after the velocity solve of a collision step (the impulses Jolt keeps for its warm start).
+/// Normal and points act on body 2 with +, on body 1 with -.
+struct ContactImpulseReport
+{
+	BodyID						mBody1;
+	BodyID						mBody2;
+	Vec3						mNormal;											///< World space, from body 1 to body 2
+	Vec3						mTangent1;
+	Vec3						mTangent2;
+	uint32						mNumPoints = 0;
+	RVec3						mPoints[64];										///< World space: where each normal impulse acts
+	float						mNormalLambda[64];
+	RVec3						mFrictionPoint;										///< World space: where the linear friction impulse acts
+	float						mFrictionLambda[2];
+	float						mAngularFrictionLambda;								///< About mNormal
+};
+
+/// Called after the velocity solve of every collision step, from the solver jobs: must be thread safe
+class ContactImpulseListener
+{
+public:
+	virtual						~ContactImpulseListener() = default;
+	virtual void				OnContactSolved(const ContactImpulseReport &inReport) = 0;
+};
+
 class JPH_EXPORT ContactConstraintManager : public NonCopyable
 {
 public:
@@ -47,6 +72,9 @@ public:
