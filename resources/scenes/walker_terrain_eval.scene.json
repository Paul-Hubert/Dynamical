{
  "format_version": 1,
  "name": "walker_terrain_eval",
  "include": ["common/humanbot_terrain_world.json"],
  "variables": {
    "view": { "type": "bool", "default": true },
    "view_truncate": { "type": "bool", "default": true },
    "num_worlds": { "type": "int", "default": 16 },
    "model": { "type": "string", "default": "" },
    "episodes": { "type": "int", "default": 100 },
    "out": { "type": "string", "default": "" },
    "legs": { "type": "string", "default": "", "description": "a CSV, one row per stretch between two target draws, with the slopes it crossed" },
    "replay": { "type": "string", "default": "" }
  },
  "worlds": [ { "template": "humanbot_terrain_world", "count": "${num_worlds}",
                "systems": { "replace": { "TrainerActions@act": "Policy@act" } } } ]
}
