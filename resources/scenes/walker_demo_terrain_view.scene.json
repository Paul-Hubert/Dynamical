{
  "format_version": 1,
  "name": "walker_demo_terrain_view",
  "include": ["common/desktop.json", "common/ik_demo_world.json"],
  "variables": {
    "draw":          { "type": "bool",  "default": true },
    "terrain_seed":  { "type": "int",   "default": 1337, "description": "the host's ChunkGenerator draws seed 1337" },
    "spawn_radius":  { "type": "float", "default": 1000.0 },
    "num_worlds":    { "type": "int",   "default": 1 },
    "view_distance": { "type": "float", "default": 3.4 },
    "view_side":     { "type": "float", "default": 75.0 }
  },
  "renderer": { "passes": ["terrain", "model", "ui"], "vr": false },
  "host": {
    "pre": [ "Input", "UI", "Time", "PlayerControl", "DebugMenu", "ChunkManager", "ChunkGenerator", "WorldStepper",
             { "name": "GaitView", "params": { "distance": "${view_distance}", "azimuth": "${view_side}" } } ],
    "post": [ { "name": "WorldView", "params": { "worlds": "all", "spacing": 0.0 } }, "Terrain" ]
  },
  "worlds": [ { "template": "ik_demo_world", "count": "${num_worlds}",
                "systems": { "replace": { "GroundPlane": { "name": "GroundTerrain", "params": { "seed": "${terrain_seed}" } } } } } ]
}
