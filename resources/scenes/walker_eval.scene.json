{
  "format_version": 1,
  "name": "walker_eval",
  "include": ["common/humanbot_world.json"],
  "variables": {
    "view": { "type": "bool", "default": true },
    "view_truncate": { "type": "bool", "default": true },
    "num_worlds": { "type": "int", "default": 16 },
    "model": { "type": "string", "default": "" },
    "episodes": { "type": "int", "default": 100 },
    "out": { "type": "string", "default": "" },
    "replay": { "type": "string", "default": "" },
    "stochastic": { "type": "int", "default": 0 },
    "cot_out": { "type": "string", "default": "" }
  },
  "worlds": [ { "template": "humanbot_world", "count": "${num_worlds}",
                "systems": { "replace": { "TrainerActions@act": "Policy@act" } } } ]
}
