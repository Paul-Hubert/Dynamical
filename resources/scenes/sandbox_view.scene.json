{
  "format_version": 1,
  "name": "sandbox_view",
  "include": [
    "common/desktop.json",
    "common/sandbox_world.json"
  ],
  "variables": {
    "num_worlds": {
      "type": "int",
      "default": 1
    },
    "models": {
      "type": "string",
      "default": "",
      "description": "a run of the trainer: <behavior>.onnx or <behavior>/<behavior>-<step>.onnx for every behaviour it has"
    },
    "prefix": {
      "type": "string",
      "default": "",
      "description": "only the behaviours whose name starts with it (Animal_: the walkers, the scripted minds over them)"
    },
    "deterministic": {
      "type": "bool",
      "default": true
    },
    "heuristic": {
      "type": "bool",
      "default": true
    },
    "draw": {
      "type": "bool",
      "default": true
    },
    "watch": {
      "type": "string",
      "default": "",
      "description": "the species the camera stays with (empty: a predator)"
    },
    "watch_distance": {
      "type": "float",
      "default": 6.0,
      "description": "from the camera to the animal, in its sizes"
    },
    "watch_height": {
      "type": "float",
      "default": 2.0,
      "description": "of the camera, in heights of the animal"
    },
    "watch_orbit": {
      "type": "float",
      "default": 6.0,
      "description": "degrees a second the camera turns round the animal"
    },
    "tour": {
      "type": "bool",
      "default": false,
      "description": "the camera goes from animal to animal, a wolf then a deer: watch_stay seconds round each"
    },
    "watch_stay": {
      "type": "float",
      "default": 5.0
    }
  },
  "renderer": {
    "passes": [
      "model",
      "ui"
    ],
    "vr": false
  },
  "host": {
    "pre": [
      "Input",
      "UI",
      "PlayerControl",
      "DebugMenu",
      "WorldStepper",
      {
        "name": "SandboxWatch",
        "params": {
          "species": "${watch}",
          "distance": "${watch_distance}",
          "height": "${watch_height}",
          "orbit": "${watch_orbit}",
          "tour": "${tour}",
          "stay": "${watch_stay}"
        }
      }
    ],
    "post": [
      {
        "name": "WorldView",
        "params": {
          "worlds": "all",
          "spacing": 0.0
        }
      }
    ]
  },
  "worlds": [
    {
      "template": "sandbox_world",
      "count": "${num_worlds}",
      "systems": {
        "replace": {
          "TrainerActions@act": {
            "name": "Policies@act",
            "params": {
              "models": "${models}",
              "prefix": "${prefix}",
              "deterministic": "${deterministic}"
            }
          }
        }
      }
    }
  ]
}
