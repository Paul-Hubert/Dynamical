{
  "variables": {
    "body":    { "type": "string", "default": "agents/bodies/heidelbot_notoes.body.json" },
    "params":  { "type": "string", "default": "agents/params/walker.params.json" },
    "draw":    { "type": "bool",   "default": false },
    "speed":   { "type": "float",  "default": 1.36, "description": "m/s, horizontal, on level ground (slopes slow the walker)" },
    "heading": { "type": "float",  "default": 0.0, "description": "degrees about +y; 0 walks toward -z" },
    "start_x": { "type": "float",  "default": 0.0 },
    "start_z": { "type": "float",  "default": 0.0 },
    "pitch":   { "type": "float",  "default": 0.0, "description": "degrees of the ground plane; positive rises toward -z (uphill at heading 0)" },
    "roll":    { "type": "float",  "default": 0.0, "description": "degrees of the ground plane; positive rises toward +x (the right side at heading 0)" }
  },
  "templates": {
    "ik_world": {
      "physics": { "threads": 1, "max_bodies": 64, "max_body_pairs": 1024, "max_contacts": 1024, "temp_bytes": 8388608,
                   "allow_sleeping": false, "friction_combine": "max", "restitution_combine": "min" },
      "clock": { "physics_hz": 60, "control_hz": 30 },
      "fixed": [ "RigidBody", "AgentFactory", { "name": "GroundPlane", "params": { "pitch": "${pitch}", "roll": "${roll}" } },
                 "GaitBase", "GaitFootIK", "GaitBalance", "Fabrik", "RigPoseApply", "PhysicsStep", "BodySync", "GaitChecks",
                 "Observation@observe" ],
      "entities": [
        { "HumanBotSpawn": { "body": "${body}", "params": "${params}", "motion": "kinematic", "recording": true, "draw": "${draw}" },
          "GaitCommand": { "speed": "${speed}", "heading": "${heading}", "start": ["${start_x}", "${start_z}"] } }
      ]
    }
  }
}
