{
  "format_version": 1,
  "name": "walker_view",
  "include": ["common/desktop.json", "common/humanbot_world.json"],
  "variables": {
    "draw": { "type": "bool", "default": true },
    "view": { "type": "bool", "default": true },
    "num_worlds": { "type": "int", "default": 1 },
    "model": { "type": "string", "default": "latest:runs/*/HeidelBotBehavior" }
  },
  "renderer": { "passes": ["model", "ui"], "vr": false },
  "host": {
    "pre": [ "Input", "UI", "PlayerControl", "DebugMenu",
             { "name": "ModelWatcher", "params": { "model": "${model}" } },
             "WorldStepper", "WalkerView" ],
    "post": [ { "name": "WorldView", "params": { "worlds": "all", "spacing": 4.0 } } ]
  },
  "worlds": [ { "template": "humanbot_world", "count": "${num_worlds}",
                "systems": { "replace": { "TrainerActions@act": "Policy@act" } } } ]
}
