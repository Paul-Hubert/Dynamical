{
  "format_version": 1,
  "name": "base",
  "include": ["common/desktop.json"],

  "renderer": { "passes": ["terrain", "grass", "model", "ui"], "vr": true },

  "host": {
    "pre": [
      "Input", "UI", "Time", "PlayerControl", "VRControl", "DebugMenu",
      { "name": "Sky", "params": { "time": "${time}", "day_length": "${day_length}" } }, "ChunkManager", "ChunkGenerator", "BoxRing", "ModelLineup", "BoxThrower",
      "RigidBody", "TerrainColliders", "Physics"
    ],
    "post": ["Terrain"]
  }
}
