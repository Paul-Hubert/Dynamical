{
  "format_version": 1,
  "name": "animal_demo_view",
  "include": [
    "common/desktop.json",
    "common/animal_demo_world.json"
  ],
  "variables": {
    "draw": {
      "type": "bool",
      "default": false,
      "description": "the shapes of the ragdoll too"
    },
    "view_distance": {
      "type": "float",
      "default": 1.5,
      "description": "from the camera to the animal, in sizes of the animal"
    },
    "view_side": {
      "type": "float",
      "default": 70.0,
      "description": "degrees the camera is swung from behind the commanded heading"
    },
    "marks": {
      "type": "float",
      "default": 0.0,
      "description": "m: a chequer of this size on the ground around the animal"
    },
    "view_log": {
      "type": "string",
      "default": "",
      "description": "a file: a line per frame (command, position, speed)"
    }
  },
  "renderer": {
    "passes": [
      "animals",
      "model",
      "ui"
    ],
    "vr": false
  },
  "host": {
    "pre": [
      "Input",
      "UI",
      "PlayerControl",
      "DebugMenu",
      "WorldStepper",
      {
        "name": "AnimalAgentView",
        "params": {
          "distance": "${view_distance}",
          "azimuth": "${view_side}",
          "marks": "${marks}",
          "log": "${view_log}"
        }
      }
    ],
    "post": [
      {
        "name": "WorldView",
        "params": {
          "worlds": "all",
          "spacing": 0.0
        }
      }
    ]
  },
  "worlds": [
    {
      "template": "animal_demo_world",
      "count": 1
    }
  ]
}
