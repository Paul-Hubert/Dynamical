// Graphics levels, from the cheapest (docs/graphics.md). graphics=<name> on the command line, or "graphics" in
// config.7.json. "high" holds the defaults of the code (test GRAPHICS.2). A value left out is the default too.
// ray_tracing and textures are read when the engine starts, the rest can change while it runs (debug menu)
{
    "presets": [
        {
            "name": "ultralow",
            "view_distance": 384,
            "ray_tracing": false,
            "lighting": {
                "desktop": { "traced_range": 0, "sun_rays": 0, "plant_geometry_range": 60, "shadowed_torches": 0, "animals": 0 },
                "vr": { "traced_range": 0, "sun_rays": 0, "plant_geometry_range": 60, "shadowed_torches": 0, "animals": 0 },
                "probe_rays_per_frame": 0,
                "rays_per_probe": 16,
                "far_plants_in_rays": false,
                "far_plants_on_screen": false
            },
            "textures": { "grass_anisotropy": 2, "ground_anisotropy": 1, "vegetation_anisotropy": 1, "animal_anisotropy": 1 },
            "ground": { "relief": 0 },
            "grass": { "layers": 1, "shadow": 0, "see_through": 0 },
            "vegetation": { "lod_bias": 0.5, "normal_maps": false, "subsurface": false },
            "streaming": { "chunk_meshes_per_frame": 2, "ray_chunks_per_frame": 2, "plant_volume_slices_per_frame": 4 }
        },
        {
            "name": "low",
